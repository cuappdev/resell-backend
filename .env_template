# Neon (preferred). Run: npx neon@latest env pull
# Runtime should use the pooled URL; migrations use the direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Legacy discrete Postgres vars (fallback if DATABASE_URL is unset)
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_USERNAME=

IS_PROD=
# Optional: DB_LOGGING=true, DB_POOL_MAX=5

# Firebase: prefer JSON string for Vercel; path works for local files
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

PORT=
IMAGE_UPLOAD_URL=
UPLOAD_BUCKET_NAME=
UPLOAD_SIZE_LIMIT=
# Comma-separated full email addresses allowed in addition to @cornell.edu (case-insensitive)
EMAIL_WHITELIST=
# OpenAI API key for semantic embeddings (similar posts, request matching, search vectors).
# Without it, embeddings stay null and those features degrade gracefully.
OPENAI_API_KEY=
# Vercel Cron Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
